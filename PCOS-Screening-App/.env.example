# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Only EXPO_PUBLIC_-prefixed variables reach the JS bundle. They are readable
# inside the shipped app, so never put a secret in one.

# Where the backend lives, including the /api suffix.
#
#   Physical device  http://<your-computer's-LAN-IP>:5000/api
#   Android emulator http://10.0.2.2:5000/api
#   iOS simulator    http://127.0.0.1:5000/api
#
# Leave unset and the app falls back to Metro's host address, which usually
# works on a physical device but is guesswork — set it explicitly.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
